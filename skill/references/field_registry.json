  "semantic_layer_version": "1.2.0",
  "_comment_semantic_v120": "v1.2.0 升级: 引入 FMCG 受管领域知识库 (fmcg_*_provenance.yaml) 的 W3C PROV-O 溯源, 为 domain_entities 每一个条目补充权威出处与置信等级; 同时注入 cognitive_concepts 业务黑话映射链与 brand_uri 实体链接, 彻底告别'裸字段裸字典'状态。详见 scripts/fmcg_knowledge_engine.py (CI Gate 强制 100% 实体带 source)。",
  "_fmcg_kb_meta": {
    "kb_root": "skill/references/fmcg_knowledge_base.yaml",
    "engine": "skill/scripts/fmcg_knowledge_engine.py",
    "engine_entrypoint": "python -m fmcg_knowledge_engine ci",
    "ci_gate_policy": "PROV-O + ISO-11179: 100% entities must carry (uri, prefLabel, definition, provenance.authority_ref, provenance.confidence_tier)",
    "forbidden_confidence_tiers": ["UNVERIFIED", "LLM_GENERATED_NO_SOURCE"],
    "provenance_authorities": [
      "GB/T 18106-2021 (零售业态分类)",
      "GB/T 4754-2017 (国民经济行业分类)",
      "NielsenIQ (NIQ) RMS Channel Taxonomy",
      "CCFA 中国连锁经营协会标准",
      "Beverage Brand RED 5P & RTM Operating Manual",
      "Marketing Channels / Sales Force Management 学术专著",
      "Wikidata Open Knowledge Graph",
      "Dianping 大众点评本地生活运营标准"
    ]
  },

  "_comment_measures": "业务度量（measures）：把'未在物理 Schema 显式编码的业务语义'显式定义。这是论文强调的语义层核心价值——例如'餐饮高评分'不是裸字段，而是'点评评分星级>=3.8'的业务口径。解析层与校验层都认这些名字，模型无法再凭概率猜测。",
  "measures": {
    "开店年限": {"field": "_derived:开店年限", "type": "numeric", "口径说明": "由 POI上线时间 推算至当前年的经营年限（年），运行期计算"},
    "高德上榜": {"field": "是否高德扫街榜/状元榜", "op": "=", "value": "Y", "type": "bool", "口径说明": "是否登上高德扫街榜/状元榜（景区/优质POI标识）"},
    "MT黄金门店": {"field": "LINX MT黄金门店", "op": "=", "value": "Y", "type": "bool", "口径说明": "是否为 LINX MT 黄金门店（零售很嗨门店）"},
    "有餐饮点评": {"field": "大众点评是否有点评信息", "op": "=", "value": "Y", "type": "bool", "口径说明": "是否有大众点评餐饮点评信息"},
    "餐饮高评分": {"field": "大众点评餐饮点评评分星级", "op": ">=", "value": 3.8, "type": "bool", "口径说明": "餐饮点评评分星级 ≥ 3.8（业务定义的高评分门槛）"},
    "潜力无协议": {"field": "月均收入潜力预测(无协议无冰柜)", "type": "numeric", "口径说明": "无协议无冰柜场景下的月均收入潜力预测（元/月）"},
    "客房100+": {"field": "携程-房间数", "op": ">", "value": 100, "type": "bool", "口径说明": "酒店客房数大于 100 间"},
    "星级4+": {"field": "携程-星级", "op": ">=", "value": 4, "type": "bool", "口径说明": "携程酒店星级 ≥ 4 星"}
  },

