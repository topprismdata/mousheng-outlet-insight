        "运动健身": ["运动场所", "健身", "运动"],
        "娱乐": ["娱乐", "休闲娱乐", "KTV"]
      }
    },
    "渠道": {"type": "category"},
    "子渠道": {"type": "category"},
    "细分渠道": {"type": "category", "alias": ["细分类别", "细分业态"]},
